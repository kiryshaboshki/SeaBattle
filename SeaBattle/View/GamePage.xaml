<Page x:Class="SeaBattle.View.GamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:SeaBattle.VM"
      Title="Игровая страница">

    <Page.DataContext>
        <local:GameVM/>
    </Page.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Информация о игре -->
        <Border Background="LightBlue" 
                Padding="10"
                Margin="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Игра в процессе" 
                           FontSize="18"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <TextBlock Text=" (Ваш ход)" 
                           FontSize="16"
                           Foreground="Green"
                           Margin="20,0,0,0"
                           VerticalAlignment="Center"/>

                <Button Content="Выйти из игры" 
                        Margin="50,0,0,0"
                        Padding="10,5"
                        HorizontalAlignment="Right"/>
            </StackPanel>
        </Border>

        <!-- Игровые поля -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Ваше поле -->
            <Border BorderBrush="Black" 
                    BorderThickness="2"
                    Padding="10">
                <StackPanel>
                    <TextBlock Text="Ваше поле" 
                               FontSize="16"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>

                    <Canvas Width="300" 
                            Height="300" 
                            Background="LightCyan"
                            x:Name="MyField">
                        <!-- Здесь будет отрисовываться ваше поле -->
                    </Canvas>
                </StackPanel>
            </Border>

            <!-- Разделитель -->
            <TextBlock Grid.Column="1" 
                       Text="VS" 
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <!-- Поле противника -->
            <Border Grid.Column="2" 
                    BorderBrush="Black" 
                    BorderThickness="2"
                    Padding="10">
                <StackPanel>
                    <TextBlock Text="Поле противника" 
                               FontSize="16"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>

                    <Canvas Width="300" 
                            Height="300" 
                            Background="LightCyan"
                            x:Name="EnemyField">
                        <!-- Здесь будет отрисовываться поле противника -->
                    </Canvas>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>