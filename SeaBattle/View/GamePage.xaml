<Page x:Class="SeaBattleWPF.View.GamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="GamePage"
      Unloaded="Page_Unloaded">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Ваше поле -->
        <StackPanel Grid.Column="0" Margin="20">
            <TextBlock Text="Ваше поле" FontSize="16" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <Border BorderBrush="Black" BorderThickness="1" 
                    Width="310" Height="310" HorizontalAlignment="Center">
                <Canvas x:Name="FieldUser1" Width="300" Height="300" 
                        Background="LightBlue" Margin="5"/>
            </Border>
            <TextBlock x:Name="YourStatus" Text="Статус: ожидание..." 
                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
        </StackPanel>

        <!-- Поле противника -->
        <StackPanel Grid.Column="1" Margin="20">
            <TextBlock Text="Поле противника" FontSize="16" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <Border BorderBrush="Black" BorderThickness="1" 
                    Width="310" Height="310" HorizontalAlignment="Center">
                <Canvas x:Name="FieldUser2" Width="300" Height="300" 
                        Background="LightBlue" Margin="5"
                        MouseLeftButtonDown="FieldUser2_MouseLeftButtonDown"/>
            </Border>
            <TextBlock x:Name="MessageText" HorizontalAlignment="Center" 
                       Margin="0,10,0,0" Foreground="Red"/>
        </StackPanel>

        <!-- Кнопка возврата -->
        <Button Content="Вернуться в меню" HorizontalAlignment="Left" 
                VerticalAlignment="Top" Margin="10" Padding="10,5"
                Click="BackButton_Click"/>
    </Grid>
</Page>