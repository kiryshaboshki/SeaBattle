<Page x:Class="SeaBattleWPF.View.ShipPlacementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="800"
      Title="Расстановка кораблей"
      Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Расстановка кораблей" 
                   FontSize="24" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,20,0,20"/>

        <!-- Игровое поле -->
        <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Ваше поле" FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <Border BorderBrush="Black" BorderThickness="2" 
                        Background="White" Padding="5">
                    <Canvas x:Name="PlacementCanvas" Width="300" Height="300" 
                            Background="LightBlue"
                            MouseLeftButtonDown="PlacementCanvas_MouseLeftButtonDown"/>
                </Border>

                <TextBlock x:Name="StatusText" Text="Кликните на поле, чтобы разместить корабль" 
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <!-- Панель управления -->
        <Border Grid.Row="2" Background="LightGray" Padding="15" Margin="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="RotateButton" Content="Повернуть корабль" 
                        Width="150" Height="35" Margin="0,0,20,0"
                        Click="RotateButton_Click"/>

                <Button x:Name="RandomButton" Content="Расставить случайно" 
                        Width="150" Height="35" Margin="0,0,20,0"
                        Click="RandomButton_Click"/>

                <Button x:Name="ClearButton" Content="Очистить поле" 
                        Width="150" Height="35" Margin="0,0,20,0"
                        Click="ClearButton_Click"/>

                <Button x:Name="ReadyButton" Content="Готово к бою!" 
                        Width="150" Height="40" FontSize="14" FontWeight="Bold"
                        Background="LightGreen" Click="ReadyButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>