<Page x:Class="SeaBattle.View.ShipPlacementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:SeaBattle.VM"
      Title="Расстановка кораблей">

    <Page.DataContext>
        <vm:ShipPlacementVM/>
    </Page.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Инструкция -->
        <Border Background="LightYellow" Padding="10" Margin="10">
            <StackPanel>
                <TextBlock Text="Расставьте ваши корабли:" 
                           FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="Корабли: 1x4, 2x3, 3x2, 4x1. Не должны соприкасаться!"
                           Margin="0,5,0,0"/>
                <TextBlock Text="Выберите корабль и кликните на поле для размещения"
                           Foreground="Gray"/>
                <TextBlock Text="{Binding StatusMessage}" 
                           FontWeight="Bold"
                           Margin="0,10,0,0"
                           Foreground="DarkBlue"/>
            </StackPanel>
        </Border>

        <!-- Игровое поле для расстановки -->
        <Border Grid.Row="1" BorderBrush="Black" BorderThickness="2" 
                Margin="20" HorizontalAlignment="Center">
            <Canvas Width="300" Height="300" Background="LightCyan"
                    x:Name="PlacementField" 
                    MouseLeftButtonDown="Field_MouseClick">
                <!-- Сетка будет рисоваться в коде -->
            </Canvas>
        </Border>

        <!-- Панель управления -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" 
                    HorizontalAlignment="Center" Margin="10">
            <ComboBox x:Name="ShipSelector" Width="120" Margin="5"
                      ItemsSource="{Binding AvailableShips}"
                      DisplayMemberPath="Description"/>

            <CheckBox Content="Горизонтально" IsChecked="{Binding IsHorizontal}"
                      Margin="5" VerticalAlignment="Center"/>

            <Button Content="Разместить" Width="100" Margin="5"
                    Command="{Binding PlaceShipCommand}"/>

            <Button Content="Очистить поле" Width="100" Margin="5"
                    Command="{Binding ClearFieldCommand}"/>

            <Button Content="Начать игру" Width="100" Margin="5"
                    Command="{Binding StartGameCommand}"
                    Background="LightGreen" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Page>