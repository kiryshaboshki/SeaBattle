<Page x:Class="SeaBattle.View.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:SeaBattle.VM"
      Title="Вход в игру">

    <Page.DataContext>
        <vm:LoginVM/>
    </Page.DataContext>

    <Grid>
        <StackPanel HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    Width="250">
            <TextBlock Text="Морской бой" 
                       FontSize="24" 
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"
                       FontWeight="Bold"/>

            <!-- НОВАЯ КНОПКА -->
            <Button Content="🎮 Быстрый старт (оффлайн)" 
                    Margin="0,0,0,20"
                    Padding="10,5"
                    Background="#2ECC71"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="OfflineMode_Click"/>

            <TextBlock Text="Или войдите:" 
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"
                       Foreground="Gray"/>

            <TextBlock Text="Логин:"/>
            <TextBox Text="{Binding LoginText, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,5,0,10"/>

            <TextBlock Text="Пароль:"/>
            <PasswordBox x:Name="PasswordBox" Margin="0,5,0,20"/>

            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center"
                        Margin="0,10">
                <Button Content="Войти" 
                        Width="80"
                        Margin="0,0,10,0"
                        Command="{Binding LoginCommand}"/>

                <Button Content="Регистрация" 
                        Width="80"
                        Command="{Binding RegistrationCommand}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>