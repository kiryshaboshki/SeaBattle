<Page x:Class="SeaBattleWPF.View.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="800"
      Title="LoginPage"
      Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Морской бой" FontSize="28" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,20,0,20"/>

        <!-- Панель выбора режима -->
        <Border Grid.Row="1" Background="LightBlue" Padding="15" Margin="10,0,10,10" 
                CornerRadius="5">
            <StackPanel>
                <TextBlock Text="Выберите режим игры:" FontSize="16" FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="OnlineModeRadio" Content="Онлайн (по сети)" 
                               GroupName="GameMode" Margin="0,0,20,0" Checked="GameMode_Checked"/>
                    <RadioButton x:Name="OfflineModeRadio" Content="Оффлайн (против ИИ)" 
                               GroupName="GameMode" Margin="0,0,20,0" Checked="GameMode_Checked"/>
                    <RadioButton x:Name="TestModeRadio" Content="Быстрый тест" 
                               GroupName="GameMode" Checked="GameMode_Checked"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Панель подключения (только для онлайн режима) -->
        <Border Grid.Row="2" Background="White" Padding="30" x:Name="OnlinePanel">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Подключение к серверу -->
                <Border Grid.Row="0" Background="AliceBlue" Padding="10" Margin="0,0,0,20" 
                        CornerRadius="5">
                    <StackPanel>
                        <TextBlock Text="Подключение к серверу:" FontSize="14" FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="IP:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox x:Name="IpTextBox" Text="127.0.0.1" Width="100" 
                                     Margin="0,0,20,0"/>

                            <TextBlock Text="Порт:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox x:Name="PortTextBox" Text="12345" Width="60" 
                                     Margin="0,0,20,0"/>

                            <Button x:Name="ConnectButton" Content="Подключиться" 
                                    Padding="10,5" Click="ConnectButton_Click"/>
                        </StackPanel>

                        <TextBlock x:Name="ConnectionStatus" Margin="0,5,0,0" 
                                   Foreground="DarkGreen"/>
                    </StackPanel>
                </Border>

                <!-- Авторизация -->
                <Border Grid.Row="1" Background="White" Padding="10" CornerRadius="5">
                    <StackPanel Width="300" HorizontalAlignment="Center">
                        <TextBlock Text="Авторизация" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

                        <TextBlock Text="Логин:"/>
                        <TextBox x:Name="LoginTextBox" Margin="0,5,0,15" Height="25"/>

                        <TextBlock Text="Пароль:"/>
                        <PasswordBox x:Name="PasswordBox" Margin="0,5,0,20" Height="25"/>

                        <Button x:Name="LoginButton" Content="Войти" Height="35" 
                                FontSize="14" Margin="0,0,0,10" Click="LoginButton_Click"/>

                        <Button x:Name="RegisterButton" Content="Регистрация" 
                                Height="35" FontSize="14" Click="RegisterButton_Click"/>

                        <!-- Кнопка быстрого старта в оффлайн режиме -->
                        <Button x:Name="QuickStartButton" Content="Быстрый старт (оффлайн)" 
                                Height="35" FontSize="14" Margin="0,20,0,0" 
                                Background="LightGreen" Click="QuickStartButton_Click"
                                Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="2" x:Name="StatusText" Foreground="Red" 
                           TextWrapping="Wrap" Margin="0,20,0,0" HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Панель оффлайн режима -->
        <Border Grid.Row="2" Background="White" Padding="30" x:Name="OfflinePanel" 
                Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Оффлайн режим" FontSize="24" FontWeight="Bold" 
                           HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <TextBlock Text="Игра против компьютерного противника" 
                           HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <Button x:Name="StartOfflineGameButton" Content="Начать игру против ИИ" 
                        Height="40" FontSize="16" Padding="20,5" 
                        Click="StartOfflineGameButton_Click"/>

                <Button x:Name="BackToModeSelectButton" Content="Выбрать другой режим" 
                        Height="30" FontSize="14" Margin="0,20,0,0"
                        Click="BackToModeSelectButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Панель тестового режима -->
        <Border Grid.Row="2" Background="White" Padding="30" x:Name="TestPanel" 
                Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Тестовый режим" FontSize="24" FontWeight="Bold" 
                           HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <TextBlock Text="Быстрая проверка механик игры" 
                           HorizontalAlignment="Center" Margin="0,0,0,20"
                           TextWrapping="Wrap" Width="400" TextAlignment="Center"/>

                <Button x:Name="TestFieldButton" Content="Тест отрисовки поля" 
                        Height="35" FontSize="14" Margin="0,0,0,10" Padding="20,5"
                        Click="TestFieldButton_Click"/>

                <Button x:Name="TestGameButton" Content="Тест игрового процесса" 
                        Height="35" FontSize="14" Margin="0,0,0,10" Padding="20,5"
                        Click="TestGameButton_Click"/>

                <Button x:Name="TestShipsButton" Content="Тест расстановки кораблей" 
                        Height="35" FontSize="14" Padding="20,5"
                        Click="TestShipsButton_Click"/>

                <Button x:Name="BackFromTestButton" Content="Назад" 
                        Height="30" FontSize="14" Margin="0,30,0,0"
                        Click="BackToModeSelectButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>