<Page x:Class="SeaBattle.View.PageListGames"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:SeaBattle.VM"
      Title="Список игр">

    <Page.DataContext>
        <vm:PageListGamesVM/>
    </Page.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="Список доступных игр" 
                   FontSize="20" 
                   HorizontalAlignment="Center"
                   Margin="10"
                   FontWeight="Bold"/>

        <!-- Список игр -->
        <ListBox Grid.Row="1" 
                 Margin="20,10"
                 ItemsSource="{Binding Games}"
                 SelectedItem="{Binding SelectedGame}"
                 DisplayMemberPath="DisplayText"/>

        <!-- Панель кнопок -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center"
                    Margin="10">
            <Button Content="Создать игру" 
                    Width="120"
                    Margin="5"
                    Command="{Binding CreateGameCommand}"/>

            <Button Content="Присоединиться" 
                    Width="120"
                    Margin="5"
                    Command="{Binding JoinGameCommand}"/>

            <Button Content="Обновить" 
                    Width="80"
                    Margin="5"
                    Command="{Binding RefreshCommand}"/>
        </StackPanel>
    </Grid>
</Page>