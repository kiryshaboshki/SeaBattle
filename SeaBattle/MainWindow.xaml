<Window x:Class="SeaBattle.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SeaBattle.VM" 
    Title="Морской бой" Height="450" Width="800">

    <Window.Resources>
        <vm:MainVM x:Key="mainVM"/>

    </Window.Resources>

    <Window.DataContext>
        <Binding Source="{StaticResource mainVM}"/>
    </Window.DataContext>

    <Frame NavigationUIVisibility="Hidden" 
           Content="{Binding PageControl.CurrentPage}">
    </Frame>
</Window>